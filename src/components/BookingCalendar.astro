---
import { introMeeting, site } from '../data/site';
import Arrow from './Arrow.astro';

const bookingUrl = introMeeting.bookingUrl.trim();
let embedUrl: URL | undefined;

if (bookingUrl) {
  embedUrl = new URL(bookingUrl);
  if (embedUrl.protocol !== 'https:' || embedUrl.hostname !== 'calendar.google.com' || !embedUrl.pathname.includes('/appointments/schedules/')) {
    throw new Error('introMeeting.bookingUrl: użyj pełnego adresu calendar.google.com z pola src kodu osadzenia strony rezerwacji.');
  }
  embedUrl.searchParams.set('gv', 'true');
  embedUrl.searchParams.set('hl', 'pl');
}

const emailHref = `mailto:${site.email}?subject=${encodeURIComponent('Bezpłatne spotkanie zapoznawcze — matura z informatyki')}&body=${encodeURIComponent(`Cześć Igor!\n\nChcę umówić bezpłatne, ${introMeeting.duration}-minutowe spotkanie online.\n\nRok, w którym zdaję maturę: \nMój poziom: \nMój cel: \nDogodne terminy: \n`)}`;
---
<section class="booking-calendar" id="rezerwacja" aria-labelledby="booking-title">
  <div class="booking-overview">
    <div class="booking-calendar-heading">
      <p class="eyebrow">{introMeeting.duration} MINUT · ONLINE · BEZPŁATNIE</p>
      <h3 id="booking-title">{embedUrl ? 'Wybierz termin naszej rozmowy.' : 'Umówmy się na rozmowę.'}</h3>
      <p>{embedUrl
        ? 'Wybierz dzień i godzinę w kalendarzu poniżej. Potwierdzenie rezerwacji i link do Google Meet otrzymasz e-mailem.'
        : 'Napisz, jakie terminy Ci odpowiadają. Wspólnie wybierzemy czas na bezpłatne spotkanie zapoznawcze.'}</p>
    </div>
    <div class="booking-agenda" aria-labelledby="booking-agenda-title">
      <h4 id="booking-agenda-title">Jak wygląda nasza rozmowa?</h4>
      <ol>
        {introMeeting.agenda.map((step, index) => (
          <li>
            <span class="booking-agenda-number" aria-hidden="true">0{index + 1}</span>
            <div><strong>{step.title}</strong><p>{step.description}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="booking-practical" aria-label="Przed spotkaniem">
    {introMeeting.practicalQuestions.map(item => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
  {embedUrl ? (
    <>
      <div class="booking-calendar-frame">
        <iframe
          src={embedUrl.href}
          title={`Rezerwacja bezpłatnego, ${introMeeting.duration}-minutowego spotkania zapoznawczego z Igorem Józefowiczem`}
          width="100%"
          height="800"
          loading="lazy"
        ></iframe>
      </div>
      <div class="booking-calendar-alternatives">
        <a class="text-link" href={bookingUrl} target="_blank" rel="noopener noreferrer">Otwórz rezerwację w Google <Arrow diagonal /></a>
        <p>Nie widzisz dogodnego terminu? <a href={emailHref}>Napisz do mnie</a> lub <a href={`tel:${site.phoneHref}`}>zadzwoń</a>.</p>
      </div>
    </>
  ) : (
    <div class="booking-calendar-alternatives">
      <a class="button button-primary button-free" href={emailHref}>Zaproponuj termin e-mailem <Arrow /></a>
      <p>Możesz też zadzwonić: <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.</p>
    </div>
  )}
</section>
