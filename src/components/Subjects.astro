---
import { Picture } from 'astro:assets';
import { site, subjectGroups } from '../data/site';
---
<section class="section container subjects-section" data-motion id="zakres" aria-labelledby="subjects-title">
  <div class="section-heading"><p class="eyebrow">03 / ZAKRES PRZYGOTOWANIA</p><div><h2 id="subjects-title">Łączysz wiedzę.<br />Rozwiązujesz samodzielnie.</h2><p>Od pierwszej linijki kodu po wnioski z danych. Pracujemy nad umiejętnościami potrzebnymi w zadaniach maturalnych.</p></div></div>
  <div class="subject-groups">{subjectGroups.map(group => <article class="subject-group" data-reveal><div class="subject-art"><Picture src={group.image} alt={group.imageAlt} formats={['avif', 'webp']} fallbackFormat="jpg" quality={75} width={960} widths={[360, 640, 960, 1280]} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) calc((100vw - 92px) / 2), (max-width: 1180px) calc((100vw - 104px) / 2), (max-width: 1376px) calc((100vw - 136px) / 2), 620px" loading="lazy" decoding="async" /></div><div class="subject-group-copy"><span class="subject-index">{group.number} / OBSZAR NAUKI</span><h3>{group.title}</h3><p>{group.description}</p><dl>{group.subjects.map(subject => <div><dt><span aria-hidden="true">{subject.code}</span>{subject.title}</dt><dd>{subject.text}</dd></div>)}</dl></div></article>)}</div>
  <div class="subject-foundation">{site.subjects.slice(4).map(subject => <div><span class:list={['foundation-code', { 'binary-code': 'base' in subject }]} aria-hidden="true">{subject.code}{'base' in subject && <sub>{subject.base}</sub>}</span><div><h3>{subject.title}</h3><p>{subject.text}</p></div></div>)}</div>
</section>
