---
import { Picture } from 'astro:assets';
import { site, subjectGroups, maturaExample } from '../data/site';
import '../styles/subjects.css';
---
<section class="section container subjects-section" data-motion id="zakres" aria-labelledby="subjects-title">
  <div class="section-heading"><p class="eyebrow">03 / ZAKRES PRZYGOTOWANIA</p><div><h2 id="subjects-title">Łączysz wiedzę.<br />Rozwiązujesz samodzielnie.</h2><p>Od pierwszej linijki kodu po wnioski z danych. Pracujemy nad umiejętnościami potrzebnymi w zadaniach maturalnych.</p></div></div>
  <div class="subject-groups">{subjectGroups.map(group => (
    <article class="subject-group" data-subject-group data-reveal>
      <div class="subject-art">
        <Picture src={group.image} alt={group.imageAlt} formats={['avif', 'webp']} fallbackFormat="jpg" quality={75} width={960} widths={[360, 640, 960, 1280]} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) calc((100vw - 92px) / 2), (max-width: 1180px) calc((100vw - 104px) / 2), (max-width: 1376px) calc((100vw - 136px) / 2), 620px" loading="lazy" decoding="async" />
      </div>
      <div class="subject-group-copy">
        <span class="subject-index">{group.number} / OBSZAR NAUKI</span><h3 id={`subject-group-${group.number}`}>{group.title}</h3><p>{group.description}</p>
        <div class="subject-tabs" data-subject-tabs hidden>
          {group.subjects.map(subject => (
            <button type="button" id={`subject-tab-${subject.id}`} data-subject-target={subject.id} aria-controls={`subject-panel-${subject.id}`}>{subject.title}</button>
          ))}
        </div>
        <div class="subject-panels">{group.subjects.map(subject => (
          <section class="subject-panel" id={`subject-panel-${subject.id}`} data-subject-panel={subject.id} aria-labelledby={`subject-heading-${subject.id}`}>
            <h4 id={`subject-heading-${subject.id}`}>{subject.title}</h4>
            <p class="subject-skill">{subject.text}</p>
            <p class="subject-example-label">Przykładowe polecenie</p>
            <p class="subject-example-task">{'example' in subject && subject.example}</p>
            {'lessonHref' in subject && subject.lessonHref && <a href={subject.lessonHref}>Zobacz przykład lekcji →</a>}
          </section>
        ))}</div>
      </div>
    </article>
  ))}</div>
  <div class="subject-foundation">{site.subjects.slice(4).map(subject => (
    <div class="foundation-card">
      <div class="foundation-heading"><span class:list={['foundation-code', { 'binary-code': 'base' in subject }]} aria-hidden="true">{subject.code}{'base' in subject && <sub>{subject.base}</sub>}</span><h3>{subject.title}</h3></div>
      <p>{subject.text}</p>
      {subject.id === 'teoria' ? <div class="foundation-example"><p class="subject-example-label">Przykład</p><p class="foundation-equation">1010<sub>2</sub> = 10<sub>10</sub></p><p>Pozycje od prawej mają wartości 1, 2, 4 i 8. Jedynki wskazują wartości, które dodajemy: 8 + 2 = 10.</p></div> : <div class="foundation-example foundation-exam">
        <p class="subject-example-label">{maturaExample.sourceLabel}</p>
        <p>{maturaExample.context}</p>
        <p class="exam-caption" id="exam-quote-label">Fragment polecenia</p>
        <blockquote aria-labelledby="exam-quote-label" cite={maturaExample.sources[0].url}><p>{maturaExample.quote}</p></blockquote>
        <p class="exam-caption" id="exam-method-label">Jak pracujemy nad zadaniem</p>
        <ol aria-labelledby="exam-method-label">{maturaExample.steps.map(step => <li><strong>{step.label}:</strong> {step.text}</li>)}</ol>
        <div class="exam-sources">{maturaExample.sources.map(source => <a href={source.url}>{source.label}</a>)}</div>
      </div>}
    </div>
  ))}</div>
</section>
<script>
  import { initSubjects } from '../scripts/subjects';
  initSubjects();
</script>
