---
import { getEntry, render } from 'astro:content';
import TaskGrading from './TaskGrading';
import ReaderContent from './ReaderContent.astro';
import ExamReaderControls from './ExamReaderControls.astro';
import { dataPath, taskPath, type ExamTaskGroup } from '../data/tasks';
import { groupAnchor, subtaskAnchor } from '../data/exam-reader';

interface Props { groups: ExamTaskGroup[] }
const { groups } = Astro.props;
const rendered = await Promise.all(groups.map(async group => ({
  ...group,
  Context: (await render(group.context)).Content,
  commands: await Promise.all(group.tasks.map(async task => {
    const grading = await getEntry('taskGrading', task.id);
    if (!grading) throw new Error(`Brak oficjalnego oceniania: ${task.id}`);
    const sheet = task.exam.files.find(file => file.path.endsWith('/' + task.context.data.sheetFile));
    const gradingFile = task.exam.files.find(file => file.path.endsWith('/' + task.context.data.gradingFile));
    if (!sheet || !gradingFile) throw new Error(`Brak pliku źródłowego: ${task.id}`);
    return { task, grading, sheet, gradingFile, Content: (await render(task.entry)).Content, Grading: (await render(grading)).Content };
  })),
})));
---
<div id="exam-tasks-panel" class="exam-task-reader" data-exam-task-reader hidden>
  <ExamReaderControls groups={groups} position="top" />
  {rendered.map(({ context, number, Context, commands }) => <article
      class="exam-reader-group" data-exam-task-group data-number={number}
      data-sheet-src={`${commands[0].sheet.path}#page=${context.data.sheetPages[0]}`}
      aria-labelledby={groupAnchor(number)} hidden>
      <header class="exam-reader-heading">
        <h3 id={groupAnchor(number)} tabindex="-1">Zadanie {number}{context.data.title !== `Zadanie ${number}` && `. ${context.data.title}`}</h3>
        <span>{commands.reduce((sum, { task }) => sum + task.points, 0)} pkt</span>
      </header>
      {context.body?.trim() && <section class="task-content task-rich-text exam-reader-context" aria-labelledby={`wprowadzenie-${number}`}>
        <h4 id={`wprowadzenie-${number}`}>Wprowadzenie</h4><ReaderContent prefix={`kontekst-${number}`}><Context /></ReaderContent>
      </section>}
      {commands.map(({ task, grading, sheet, gradingFile, Content, Grading }) => <section class="exam-reader-subtask" data-reader-subtask={task.number} aria-labelledby={subtaskAnchor(task.number)}>
        <div class="exam-reader-heading"><h4 id={subtaskAnchor(task.number)} tabindex="-1">{task.number}. {task.title}</h4><span>{task.points} pkt</span></div>
        {task.entry.data.editorialNote && <aside class="archive-notice"><h5>Uwaga o materiale źródłowym</h5><p>{task.entry.data.editorialNote}</p></aside>}
        <div class="task-content task-rich-text" aria-label={`Polecenie CKE — zadanie ${task.number}`}><ReaderContent prefix={`polecenie-${subtaskAnchor(task.number)}`}><Content /></ReaderContent></div>
        <div class="exam-reader-materials">
          {task.entry.data.dataFiles.length > 0 && <div class="exam-downloads">{task.entry.data.dataFiles.map(name => <a class="file-link" href={dataPath(task.exam.id, name)} download><span>{name.split('/').at(-1)}</span><small>Plik do zadania ↓</small></a>)}</div>}
          <div class="exam-reader-links">
            <a class="text-link" href={`${sheet.path}#page=${task.entry.data.sheetPages[0]}`} target="_blank" rel="noopener">Polecenie w PDF · str. {task.entry.data.sheetPages[0]} ↗</a>
            <a class="text-link" data-reader-practice data-reader-group={number} data-reader-anchor={subtaskAnchor(task.number)} href={`${taskPath(task)}?powrot=${encodeURIComponent(`/arkusze/${task.exam.slug}/?widok=zadania&zadanie=${number}#${subtaskAnchor(task.number)}`)}`}>Ćwicz ten podpunkt <span class="sr-only">{task.number}</span> ↗</a>
          </div>
        </div>
        <TaskGrading id={`ocenianie-${subtaskAnchor(task.number)}`} answerStatus={grading.data.answerStatus} editorialNote={grading.data.editorialNote} sourceHref={`${gradingFile.path}#page=${task.entry.data.gradingPages[0]}`} sourcePage={task.entry.data.gradingPages[0]}><ReaderContent prefix={`ocenianie-${subtaskAnchor(task.number)}`}><Grading /></ReaderContent></TaskGrading>
      </section>)}
    </article>)}
  <ExamReaderControls groups={groups} position="bottom" />
</div>
