---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
import GeometryBackdrop from './GeometryBackdrop.astro';
---
<section class="section container about geometry-host" data-motion id="o-mnie" aria-labelledby="about-title">
  <GeometryBackdrop />
  <div class="about-copy" data-reveal><p class="eyebrow">03 / POZNAJMY SIĘ</p><h2 id="about-title">{site.about.title}</h2>{site.about.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href={site.personal}>Więcej o mnie <Arrow diagonal /></a></div>
  <div class="projects"><div class="projects-heading"><span>MOJE PROJEKTY</span><span aria-hidden="true">↗</span></div>{site.projects.map((project, index) => <a class:list={['project', `project-${index}`]} href={project.url} data-card data-reveal style={`--reveal-delay: ${index * 80}ms`}><div class="project-top"><span>{project.category}</span><Arrow diagonal /></div><h3>{project.name}</h3><p>{project.description}</p><span class="project-domain">{new URL(project.url).hostname}</span></a>)}</div>
</section>
