---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import ExamTaskReader from '../../components/ExamTaskReader.astro';
import { getTasks, groupExamTasks, taskPath } from '../../data/tasks';
import { subtaskAnchor } from '../../data/exam-reader';
import '../../styles/exam-reader.css';
import { exams, examTitle, examDescription, examKinds, fileSize, fileFormat } from '../../data/exams';
export function getStaticPaths() { return exams.map(exam => ({ params: { slug: exam.slug }, props: { exam } })); }
const { exam } = Astro.props;
const title = examTitle(exam);
const tasks = (await getTasks()).filter(task => task.exam.id === exam.id).sort((a,b) => a.number.localeCompare(b.number, "pl", { numeric: true }));
const groups = groupExamTasks(tasks);
const sheets = exam.files.filter(file => file.kind === 'sheet' && fileFormat(file) === 'PDF');
---
<ArchiveLayout title={title} description={examDescription(exam)} canonical={`/arkusze/${exam.slug}/`} compactNavigation breadcrumbs={[{ name: 'Strona główna', path: '/' }, { name: 'Arkusze maturalne', path: '/arkusze/' }, { name: `Informatyka ${exam.year} — ${exam.sessionLabel}`, path: `/arkusze/${exam.slug}/` }]}>
  <header slot="navigation" class="exam-header">
    <nav aria-label="Nawigacja arkusza"><a class="text-link" data-archive-back href="/arkusze/">← Arkusze</a></nav>
    <div>
      <h1>Informatyka {exam.year} <span>— {exam.sessionLabel}</span></h1>
      <p class="exam-metadata">{exam.formulaLabel} · {exam.level} · {examKinds[exam.kind]}</p>
    </div>
  </header>
  {exam.missing.length > 0 && <aside class="archive-notice"><h2>Ten zestaw jest niepełny</h2><p>Nie udało się pozyskać: {exam.missing.join(', ')}. Paczka ZIP zawiera wyłącznie pliki wymienione poniżej.</p></aside>}
  <section aria-labelledby="exam-files-title" class="exam-files exam-files-compact">
    <h2 id="exam-files-title" class="sr-only">Materiały do pobrania</h2>
    <div class="exam-downloads">
      {exam.files.map(file => <a class="file-link" href={file.path} download><span>{file.label}</span><small>{fileFormat(file)} · {fileSize(file.size)}</small></a>)}
      <a class="file-link file-bundle" href={exam.bundle.path} download><span>{exam.missing.length ? 'Dostępne pliki ZIP — niepełny zestaw' : 'Cały zestaw ZIP'}</span><small>ZIP · {fileSize(exam.bundle.size)}</small></a>
    </div>
  </section>
  {sheets.length > 0 && <section class="exam-preview" aria-labelledby="exam-reader-heading">
    <div class="exam-reader-toolbar" id="exam-preview-title" tabindex="-1">
      <h2 id="exam-reader-heading" class="sr-only">Podgląd arkusza</h2>
      {groups.length > 0 && <div class="exam-reading-modes" role="group" aria-label="Tryb czytania arkusza" data-reader-modes hidden>
        <button type="button" data-reader-mode="pdf" aria-pressed="true" aria-controls="exam-pdf-panel">PDF</button>
        <button type="button" data-reader-mode="zadania" aria-pressed="false" aria-controls="exam-tasks-panel">Zadania</button>
      </div>}
      <div class="preview-actions" data-reader-pdf-actions>{sheets.map((file, index) => <div>{sheets.length > 1 && <button type="button" data-preview-src={file.path} aria-pressed={index === 0 ? 'true' : 'false'} hidden>{file.label}</button>}<a class="text-link" href={file.path} target="_blank" rel="noopener">{sheets.length > 1 ? `Otwórz PDF: ${file.label}` : 'Otwórz PDF'} <span aria-hidden="true">↗</span></a></div>)}</div>
    </div>
    <div id="exam-pdf-panel" data-exam-pdf-panel>
      <iframe data-exam-preview src={sheets[0].path} title={`Podgląd: ${sheets[0].label} — ${title}`} loading="lazy" />
    </div>
    {groups.length > 0 && <ExamTaskReader groups={groups} />}
  </section>}
  {tasks.length > 0 && <section class="exam-task-index" id="zadania-arkusza" aria-labelledby="exam-tasks-title"><h2 id="exam-tasks-title">Zadania z tego arkusza</h2><p>Wybierz podpunkt, aby przeczytać jego treść i sprawdzić odpowiedź CKE.</p><ul>{tasks.map(task => <li><a class="text-link" data-exam-task data-reader-group={task.context.data.number} data-reader-anchor={subtaskAnchor(task.number)} href={`${taskPath(task)}?powrot=${encodeURIComponent(`/arkusze/${exam.slug}/`)}`}>{task.number}. {task.title}</a><span>{task.points} pkt</span></li>)}</ul></section>}
  <p class="materials-tutoring">Potrzebujesz pomocy w przygotowaniu do matury? <a href="/#oferta">Zobacz korepetycje ↗</a></p>
  <aside class="archive-source">
    <p>Materiały i odpowiedzi: CKE.</p>
    <ul>{exam.sourcePages.map((source, index) => <li><a href={source} target="_blank" rel="noopener">Oficjalne źródło materiałów{exam.sourcePages.length > 1 ? ` (${index + 1})` : ''} ↗</a></li>)}</ul>
    {exam.formula !== '2023' && <p>Starsze zestawy służą do ćwiczeń i mogą różnić się od aktualnych wymagań egzaminacyjnych.</p>}
  </aside>
</ArchiveLayout>
<script>
  import '../../scripts/exam-reader';
</script>
