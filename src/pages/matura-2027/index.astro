---
import PublicationLayout from '../../layouts/PublicationLayout.astro';
import { exam2027 } from '../../data/matura-2027';
import { studySections, studySkills, studyPaths, studyMapNote } from '../../data/study-skills';
import { getTasks, taskPath } from '../../data/tasks';
import topics from '../../data/task-topics.json';
import { Code } from 'astro:components';
import '../../styles/guide.css';
const tasks = await getTasks();
const taskMap = new Map(tasks.map(t => [t.id, t]));
const skillMap = new Map(studySkills.map(s => [s.id, s]));
if (skillMap.size !== studySkills.length) throw new Error('Duplicate study skill identifier');
for (const skill of studySkills) {
  if (!studySections.some(s => s.id === skill.section)) throw new Error(`Unknown study section: ${skill.id}`);
  for (const id of skill.topicIds) if (!topics.some(t => t.id === id)) throw new Error(`Unknown study topic: ${id}`);
  for (const id of skill.taskIds) if (!taskMap.has(id)) throw new Error(`Unknown study task: ${id}`);
}
for (const path of studyPaths) for (const step of path.steps) {
  for (const id of step.skillIds) if (!skillMap.has(id)) throw new Error(`Unknown path skill: ${id}`);
  for (const id of step.taskIds) if (!taskMap.has(id)) throw new Error(`Unknown path task: ${id}`);
}
const sourceHref = (id: string) => `#zrodlo-${id}`;
const toc = [{id:'egzamin', label:'Egzamin w pigułce'}, {id:'zasady',label:'Zasady i stanowisko'}, {id:'umiejetnosci',label:'Co trzeba umieć'}, {id:'typy-zadan',label:'Rodzaje zadań'}, {id:'plan-nauki',label:'Twoja ścieżka'}, {id:'strategia',label:'Strategia na egzamin'}, {id:'checklista',label:'Przed egzaminem'}, {id:'pytania',label:'Pytania i odpowiedzi'}, {id:'zrodla',label:'Źródła'}];
const pythonExample = `with open("liczby.txt", encoding="utf-8") as file:\n    numbers = [int(line.strip()) for line in file]\n\neven_count = sum(1 for number in numbers if number % 2 == 0)\n\nwith open("wynik.txt", "w", encoding="utf-8") as file:\n    file.write(str(even_count))`;
---
<PublicationLayout title="Matura z informatyki 2027 — zasady, wymagania i plan nauki" description="Przewodnik po rozszerzonej maturze z informatyki 2027. Zasady CKE, mapa umiejętności, zadania i trzy ścieżki przygotowania. Zapisz swoją checklistę." canonical="/matura-2027/" breadcrumbs={[{name:'Strona główna',path:'/'},{name:'Wiedza',path:'/wiedza/'},{name:'Matura 2027',path:'/matura-2027/'}]} activeSection="/matura-2027/" guide article={{author:'Igor Józefowicz',publishedAt:exam2027.verifiedAt,updatedAt:exam2027.verifiedAt}}>
  <header class="guide-hero">
    <div class="guide-hero-copy">
      <p class="eyebrow">TWÓJ PRZEWODNIK · FORMUŁA 2023</p>
      <h1>Matura z informatyki.<br /><span>Wiesz, dokąd zmierzasz.</span></h1>
      <p class="guide-lead">Poznaj zasady. Uporządkuj wiedzę. Przejdź do zadań. Przygotuj się do rozszerzenia z planem, który zaczyna się od Twoich umiejętności.</p>
      <div class="guide-actions"><a href="#umiejetnosci" class="button button-primary">Sprawdź, co trzeba umieć <span aria-hidden="true">↗</span></a><a href="#egzamin" class="text-link">Poznaj zasady egzaminu</a></div>
      <p class="guide-verified">Opracowanie: Igor Józefowicz · Weryfikacja źródeł: <time datetime={exam2027.verifiedAt}>{new Date(exam2027.verifiedAt).toLocaleDateString('pl-PL',{timeZone:'UTC'})}</time></p>
    </div>
    <div class="guide-art" aria-label="Pięć obszarów przygotowania do matury 2027">
      <div class="guide-art-grid" aria-hidden="true"></div><span class="guide-art-year" aria-hidden="true">2027</span>
      <div class="guide-art-core"><span class="eyebrow">OD WIEDZY</span><strong>do rozwiązania.</strong><span>Twój kierunek →</span></div>
      <ol class="guide-orbit">{studySections.map((s,i)=><li><a href={`#dzial-${s.id}`}><span>{String(i+1).padStart(2,'0')}</span>{s.title}</a></li>)}</ol>
      <span class="guide-art-caption">POŁĄCZ UMIEJĘTNOŚCI. ZOBACZ CAŁOŚĆ.</span>
    </div>
  </header>
  <div class="guide-layout">
    <aside class="guide-sidebar"><details open class="guide-toc"><summary>W przewodniku <span aria-hidden="true">↗</span></summary><nav aria-label="Spis treści przewodnika"><ol>{toc.map((item,i)=><li><a href={`#${item.id}`}><span>{String(i+1).padStart(2,'0')}</span>{item.label}</a></li>)}</ol></nav></details><p class="guide-sidebar-note">Przeczytaj po kolei albo zacznij od tego, czego dziś potrzebujesz.</p></aside>
    <div class="guide-body" data-study-guide>
      <section id="egzamin" class="guide-section">
        <p class="eyebrow">01 / OFICJALNE INFORMACJE CKE</p><h2>Egzamin w pigułce.</h2>
        <p>Przewodnik dotyczy rozszerzenia w Formule 2023 dla uczniów liceum i technikum. Sprawdź swoją formułę, zwłaszcza jeśli poprawiasz egzamin z wcześniejszych lat.</p>
        <div class="guide-facts">{exam2027.facts.map(f=><div><span>{f.label}</span><strong>{f.value}</strong><a href={sourceHref(f.sourceId)}>Źródło CKE ↗</a></div>)}</div>
        <p>Standardowy czas pracy wynosi 210 minut. Może zostać przedłużony w przypadku przyznanych dostosowań warunków egzaminu. <a href={sourceHref('harmonogram')}>Źródło CKE ↗</a></p>
        <div class="guide-note"><strong>Wynik to także sposób rozwiązania.</strong><p>Sam poprawny wynik nie zawsze wystarczy. Czytaj, jakiego zapisu, programu lub pliku wymaga polecenie.</p></div>
      </section>
      <section id="zasady" class="guide-section">
        <p class="eyebrow">02 / OFICJALNE ZASADY</p><h2>Przygotuj także swoje stanowisko.</h2>
        <div class="guide-rules">{exam2027.rules.map((r,i)=><article><span class="guide-index">{String(i+1).padStart(2,'0')}</span><div><h3>{r.title}</h3><p>{r.text}</p>{r.items && <ul class="guide-aids-list">{r.items.map(item=><li>{item}</li>)}</ul>}<a class="guide-source-link" href={sourceHref(r.sourceId)}>Dokument i strony ↗</a></div></article>)}</div>
        <p class="guide-note">Szczegóły dostępnego stanowiska i oprogramowania ustal ze szkołą. Przykłady w tym przewodniku wykorzystują Python; dopuszczone rozwiązania opisuje komunikat CKE.</p>
      </section>
      <section id="umiejetnosci" class="guide-section">
        <p class="eyebrow">03 / TWOJA MAPA UMIEJĘTNOŚCI</p><h2>Co już umiesz?<br /><span>Co warto przećwiczyć?</span></h2>
        <p>Każdy punkt opisuje konkretną umiejętność. Rozwiń go, sprawdź przykład i spróbuj zadania. Oznaczenia są Twoją samooceną — pomagają zaplanować naukę.</p>
        <p class="guide-map-note">{studyMapNote}</p>
        <div class="guide-progress-panel" data-study-controls hidden>
          <div><span class="eyebrow">TWOJA SAMOOCENA</span><strong data-study-total>0 z {studySkills.length} opanowanych</strong><progress data-study-progress max={studySkills.length} value="0" aria-label="Liczba opanowanych umiejętności"></progress><p data-study-counts></p></div>
          <div><p data-study-storage role="status">Postęp zapisuje się tylko w tej przeglądarce.</p><button type="button" class="guide-reset" data-study-reset>Wyzeruj postęp</button></div>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-study-announcement></p>
        <noscript><p class="guide-note">Przykłady i zadania są dostępne bez JavaScriptu. Włącz JavaScript, aby zapisywać samoocenę i checklistę w tej przeglądarce.</p></noscript>
        {studySections.map((section,index)=><section id={`dzial-${section.id}`} class="guide-skill-section" data-study-section={section.id}>
          <header><span class="guide-section-symbol" aria-hidden="true">{['</>','ƒ(n)','Σ','SQL','01'][index]}</span><div><p class="eyebrow">{section.kicker}</p><h3>{section.title}</h3></div><span class="guide-section-count" data-section-count={section.id} hidden></span></header>
          <p>{section.description}</p>
          <div class="guide-skills">{studySkills.filter(s=>s.section===section.id).map(skill=><div class="guide-skill-row"><details class="guide-skill" id={`umiejetnosc-${skill.id}`} data-skill={skill.id} data-section={skill.section}>
            <summary><span>{skill.title}</span><span class="guide-expand" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5v14" /></svg></span></summary>
            <div class="guide-skill-content"><p class="guide-can-do"><strong>Potrafię:</strong> {skill.canDo}</p><p class="guide-prerequisite"><strong>Przyda się wcześniej:</strong> {skill.prerequisites.join(' · ') || 'Możesz zacząć od tego punktu.'}</p>
              <div class="guide-example"><span class="eyebrow">MAŁY PRZYKŁAD</span><p>{skill.example}</p></div>
              <div class="guide-skill-tips"><p><strong>Uważaj na</strong>{skill.pitfall}</p><p><strong>Sprawdź się</strong>{skill.check}</p></div>
              <p class="guide-requirement">Odniesienie do wymagań: <a href={skill.sourceUrl}>{skill.requirement} ↗</a></p>
              {skill.taskIds.length > 0 ? <ul class="guide-task-links">{skill.taskIds.map(id=>{const task=taskMap.get(id)!;return <li><a href={taskPath(task)}>{task.year} · zad. {task.number} — {task.title}<span aria-hidden="true"> ↗</span></a></li>})}</ul> : <p class="guide-gap">W obecnej bazie nie ma jeszcze dobranego ćwiczenia do tej umiejętności. Zacznij od przykładu powyżej.</p>}
              {skill.topicIds.map(id=><a class="guide-topic-link" href={`/zadania/tematy/${id}/`}>{topics.find(t=>t.id===id)!.name} →</a>)}

            </div>
          </details><div class="guide-skill-control" data-study-controls hidden><label class="sr-only" for={`status-${skill.id}`}>Samoocena: {skill.title}</label><select id={`status-${skill.id}`} data-skill-select={skill.id}><option value="learn">Do nauki</option><option value="review">Do powtórki</option><option value="done">Opanowane</option></select></div></div>)}</div>
        </section>)}
      </section>
      <section id="typy-zadan" class="guide-section">
        <p class="eyebrow">04 / OD POLECENIA DO ODPOWIEDZI</p><h2>Rozpoznaj zadanie.<br /><span>Dobierz metodę.</span></h2>
        <p class="guide-editorial">Autorskie przykłady i wskazówki do nauki</p>
        <div class="guide-flow" aria-label="Proces rozwiązania"><span><small>01</small>Dane</span><span aria-hidden="true">→</span><span><small>02</small>Metoda</span><span aria-hidden="true">→</span><span><small>03</small>Wynik</span></div>
        <article class="guide-task-type"><h3>Analiza algorytmu: wykonaj go na papierze</h3><p>Zapisuj stan zmiennych po każdym kroku. Dla sumowania liczb [3, −1, 4] kolejne wartości sumy to 3, 2, 6. Sprawdź, czy polecenie pyta o wynik końcowy, liczbę operacji czy stan w środku pętli.</p><a href="/zadania/tematy/analiza-i-symulacja/">Ćwicz analizę i symulację →</a></article>
        <article class="guide-task-type"><h3>Program: wczytaj, przetwórz, zapisz</h3><p>Przykład: policz parzyste liczby z pliku, w którym każdy wiersz zawiera jedną liczbę całkowitą. Dla danych 3, 8, 0, −2 poprawny wynik to 3. Zero i liczby ujemne też wymagają uwagi.</p><Code code={pythonExample} lang="python" theme="github-light" /><p>Przetestuj rozwiązanie na małym zestawie, który potrafisz policzyć ręcznie. Zachowaj kod oraz wymagany plik wynikowy.</p><a href="/zadania/tematy/pliki/">Ćwicz pracę z plikami →</a></article>
        <article class="guide-task-type"><h3>Arkusz: wybierz dane i sprawdź jednostki</h3><div class="guide-data-example"><table><caption>Przykład autorski: opad w dwóch dniach</caption><thead><tr><th>Dzień</th><th>Opad [mm]</th></tr></thead><tbody><tr><td>1 maja</td><td>2</td></tr><tr><td>2 maja</td><td>6</td></tr></tbody><tfoot><tr><th>Średnia</th><td>4 mm</td></tr></tfoot></table><p>Wynik powinien zgadzać się z zakresem formuły. Przy większym zbiorze skontroluj import dat i liczb, warunki filtrowania, zaokrąglenia oraz opisy osi wykresu.</p></div><a href="/zadania/tematy/analiza-danych/">Ćwicz analizę danych →</a></article>
        <article class="guide-task-type"><h3>Baza: najpierw relacja, potem zapytanie</h3><div class="guide-relation"><div><strong>Uczniowie</strong><span>id_ucznia · imię</span></div><span aria-label="jeden do wielu">1 → N</span><div><strong>Wyniki</strong><span>id_ucznia · punkty</span></div></div><p>Uczeń może mieć kilka wyników. Połącz tabele po identyfikatorze, a średnią policz dla każdego ucznia. Łączenie po imieniu może połączyć różne osoby i zmienić wynik.</p><a href="/zadania/tematy/relacje-i-laczenie-tabel/">Ćwicz relacje i łączenie tabel →</a></article>
        <article class="guide-task-type"><h3>Teoria: uzasadnij, zamiast zgadywać</h3><p>Czy zapis 1010₂ oznacza dziesięć? Tak: 1 · 2³ + 0 · 2² + 1 · 2¹ + 0 · 2⁰ = 10. Rozpisanie definicji pomaga także w zadaniach o logice, reprezentacji danych i bezpieczeństwie.</p><a href="/zadania/tematy/systemy-liczbowe/">Ćwicz systemy liczbowe →</a></article>
      </section>
      <section id="plan-nauki" class="guide-section">
        <p class="eyebrow">05 / AUTORSKI PLAN PRZYGOTOWAŃ</p><h2>Zacznij tam,<br /><span>gdzie jesteś.</span></h2><p>Wybierz ścieżkę odpowiadającą Twojej sytuacji. Tempo dopasuj do czasu i umiejętności. Do następnego etapu przejdź, gdy potrafisz samodzielnie wykonać opisane zadanie.</p>
        <div class="guide-paths">{studyPaths.map((path,index)=><article class="guide-path" data-path={path.id}><header><span class="guide-index">0{index+1}</span><h3>{path.title}</h3></header><p>{path.description}</p><button type="button" class="guide-path-button" data-path-choice={path.id} aria-pressed="false" data-study-controls hidden>Wybieram tę ścieżkę</button><ol>{path.steps.map(step=><li><h4>{step.title}</h4><p>{step.text}</p><div class="guide-path-links">{step.skillIds.map(id=><a href={`#umiejetnosc-${id}`}>{skillMap.get(id)!.title} ↗</a>)}{step.taskIds.map(id=>{const task=taskMap.get(id)!;return <a href={taskPath(task)}>{task.year} · zad. {task.number} ↗</a>})}</div><p class="guide-done-when"><strong>Idź dalej, gdy:</strong> {step.doneWhen}</p></li>)}</ol></article>)}</div>
        <a class="text-link" href="/arkusze/?formula=2023">Wybierz pełny arkusz do próby →</a>
      </section>
      <section id="strategia" class="guide-section">
        <p class="eyebrow">06 / WSKAZÓWKI AUTORSKIE</p><h2>Pokaż to, co umiesz.</h2>
        <div class="guide-strategy"><article><span>01</span><h3>Przeczytaj efekt końcowy</h3><p>Zaznacz, co trzeba oddać: liczbę, uzasadnienie, algorytm, program, zestawienie czy wykres. Przepisz istotne nazwy plików.</p></article><article><span>02</span><h3>Zacznij od pewnego kroku</h3><p>Przejrzyj arkusz i wybierz zadanie, które potrafisz rozpocząć. Jeśli utkniesz, zanotuj stan pracy i przejdź dalej. Wróć z pozostałym czasem.</p></article><article><span>03</span><h3>Testuj małe przypadki</h3><p>Sprawdź granice, zero, liczby ujemne, powtórzenia i remisy — o ile dopuszczają je dane. Porównaj wynik z ręcznym obliczeniem.</p></article><article><span>04</span><h3>Zostaw czas na oddanie</h3><p>Otwórz zapisane pliki, skontroluj nazwy i lokalizację. Sprawdź kompletność odpowiedzi zgodnie z poleceniami i instrukcjami egzaminu.</p></article></div>
        <aside class="guide-note"><h3>Po każdym treningu: trzy zdania o błędzie</h3><p>Co zrobiłem? Dlaczego wynik był błędny? Jak sprawdzę podobne zadanie następnym razem? Wróć do niego po przerwie i rozwiąż je ponownie bez podglądania odpowiedzi.</p></aside>
      </section>
      <section id="checklista" class="guide-section">
        <p class="eyebrow">07 / ORGANIZACJA PRZYGOTOWAŃ</p><h2>Przed egzaminem.<br /><span>Spokojnie, po kolei.</span></h2><p>Praktyczna lista do odhaczenia. Oficjalne zasady i terminy znajdziesz w dokumentach poniżej oraz w swojej szkole.</p>
        <ul class="guide-checklist">{exam2027.checklist.map(item=><li><input type="checkbox" id={`check-${item.id}`} data-study-check={item.id} disabled /><label for={`check-${item.id}`}>{item.label}</label></li>)}</ul>
        <button class="guide-print" type="button" data-study-print hidden>Wydrukuj przewodnik / zapisz PDF ↗</button>
      </section>
      <section id="pytania" class="guide-section"><p class="eyebrow">08 / WARTO WIEDZIEĆ</p><h2>Pytania przed startem.</h2><div class="guide-faq">{exam2027.faq.map(item=><details><summary>{item.question}</summary><div><p>{item.answer}</p>{item.sourceId && <a href={sourceHref(item.sourceId)}>Źródło odpowiedzi ↗</a>}</div></details>)}</div></section>
      <section id="zrodla" class="guide-section"><p class="eyebrow">09 / SPRAWDŹ U ŹRÓDŁA</p><h2>Wiedza z dobrym oparciem.</h2><p>Zasady egzaminu opracowano na podstawie poniższych dokumentów. Mapa umiejętności zawiera dodatkowo odnośniki do właściwych wymagań. Kolejność nauki, przykłady i strategie są opracowaniem autorskim.</p><ol class="guide-sources">{exam2027.sources.map(source=><li id={`zrodlo-${source.id}`}><a href={source.url}>{source.title} ↗</a><span>{source.pages}</span></li>)}</ol><a class="text-link" href="/wiedza/">Przejdź do bazy wiedzy →</a></section>
    </div>
  </div>
</PublicationLayout>
<script>import '../../scripts/study-guide';</script>
