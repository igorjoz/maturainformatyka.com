---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import socialPortrait from '../assets/portrait-social.png';
import { site, introMeeting, testimonials, faqs, maturaExample } from '../data/site';
import { preparePageProps } from '../build/page-props';
import Footer from '../components/Footer';
import logo from '../assets/logo-book-code.png';
import '../styles/subjects.css';
import '../styles/lesson-lab.css';
import '../styles/refresh.css';
import '../styles/celebration.css';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.tsx';
import IntroMeeting from '../components/IntroMeeting.tsx';
import Learning from '../components/Learning.tsx';
import LessonExample from '../components/LessonExample.tsx';
import Subjects from '../components/Subjects.tsx';
import Faq from '../components/Faq.tsx';
import About from '../components/About.tsx';
import Testimonials from '../components/Testimonials.tsx';
import Offer from '../components/Offer.tsx';
import Contact from '../components/Contact.tsx';
const props = await preparePageProps();
const socialImage = await getImage({ src: socialPortrait, width: 1122, format: 'jpg' });
const socialUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#18364a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={socialUrl.href} />
    <meta property="og:image:width" content={String(socialImage.attributes.width)} />
    <meta property="og:image:height" content={String(socialImage.attributes.height)} />
    <meta property="og:image:alt" content="Igor Józefowicz — mentoring do matury z informatyki" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <title>{site.title}</title>
  </head>
  <body>
    <Header site={{ navigation: site.navigation }} logo={logo.src} client:load />
    <main id="tresc">
      <Hero site={{ name: site.name, hero: site.hero, onlinePrice: site.onlinePrice }} introMeeting={{ duration: introMeeting.duration, format: introMeeting.format, costLabel: introMeeting.costLabel, cta: introMeeting.cta }} portraitImage={props.portraitImage} client:load />
      <Learning site={{ steps: site.steps }} client:visible={{ rootMargin: '200px' }} />
      <LessonExample lesson={props.lesson} client:visible={{ rootMargin: '200px' }} />
      <Subjects site={{ subjects: site.subjects }} groups={props.groups} maturaExample={maturaExample} client:visible={{ rootMargin: '200px' }} />
      <About site={{ about: site.about, projects: props.site.projects, personal: site.personal }} client:visible={{ rootMargin: '200px' }} />
      <Testimonials site={{ listing: site.listing }} testimonials={testimonials} client:visible={{ rootMargin: '200px' }} />
      <Offer site={{ onlinePrice: site.onlinePrice, benefits: site.benefits, durations: site.durations }} introMeeting={{ duration: introMeeting.duration, cta: introMeeting.cta }} client:visible={{ rootMargin: '200px' }} />
      <IntroMeeting site={{ email: site.email, phone: site.phone, phoneHref: site.phoneHref }} introMeeting={introMeeting} />
      <Faq site={{ email: site.email }} faqs={faqs} />
      <Contact site={{ email: site.email, phone: site.phone, phoneHref: site.phoneHref, listing: site.listing }} introMeeting={{ duration: introMeeting.duration, format: introMeeting.format, costLabel: introMeeting.costLabel, cta: introMeeting.cta }} client:visible={{ rootMargin: '200px' }} />
    </main>
    <Footer year={new Date().getFullYear()} name={site.name} personal={site.personal} />
  </body>
</html>
