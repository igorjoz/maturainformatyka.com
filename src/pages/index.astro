---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import socialPortrait from '../assets/portrait-social.png';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import IntroMeeting from '../components/IntroMeeting.astro';
import Learning from '../components/Learning.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import Offer from '../components/Offer.astro';
import Contact from '../components/Contact.astro';
import Arrow from '../components/Arrow.astro';
const socialImage = await getImage({ src: socialPortrait, width: 1122, format: 'jpg' });
const socialUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#18364a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={socialUrl.href} />
    <meta property="og:image:width" content={String(socialImage.attributes.width)} />
    <meta property="og:image:height" content={String(socialImage.attributes.height)} />
    <meta property="og:image:alt" content="Igor Józefowicz — mentoring do matury z informatyki" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <title>{site.title}</title>
  </head>
  <body>
    <Header />
    <main id="tresc"><Hero /><IntroMeeting /><Learning /><About /><Testimonials /><Offer /><Contact /></main>
    <footer class="container footer"><span>© {new Date().getFullYear()} {site.name}</span><span>Matura z informatyki. Przygotowanie z planem.</span><a href={site.personal}>Strona osobista <Arrow diagonal /></a><span class="page-end" data-page-end aria-hidden="true"></span></footer>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
