---
import PublicationLayout from '../../layouts/PublicationLayout.astro';
import { getPublications, publicationPath, publicationSections, publicationDateLabel } from '../../data/publications';
const publications = await getPublications();
const guide = publications.find(entry => entry.data.kind === 'guide');
const articles = publications.filter(entry => entry.data.kind === 'article');
---
<PublicationLayout title="Baza wiedzy — zrozum informatykę, przygotuj się do matury" description="Przewodniki i materiały do matury z informatyki. Wymagania, algorytmy, programowanie i praca z danymi połączone z zadaniami do samodzielnego treningu." canonical="/wiedza/" breadcrumbs={[{name:'Strona główna',path:'/'},{name:'Wiedza',path:'/wiedza/'}]}>
  <header class="knowledge-heading"><p class="eyebrow">ZROZUM. POŁĄCZ. PRZEĆWICZ.</p><h1>Wiedza, z której<br /><em>zrobisz użytek.</em></h1><p>Uporządkuj przygotowania. Od wymagań i sposobu pracy po konkretne zadania — każdy materiał ma pomóc Ci zrobić następny krok.</p></header>
  {guide && <article class="knowledge-feature">
    <div class="knowledge-feature-copy"><p class="publication-kicker">ZACZNIJ TUTAJ · FORMUŁA 2023</p><h2><a href={publicationPath(guide)}>Matura {guide.data.examYear}.<br />Twój plan przygotowań.</a></h2><p>{guide.data.description}</p><ul class="knowledge-feature-points"><li>Zasady i źródła CKE</li><li>Mapa umiejętności</li><li>Trzy ścieżki nauki</li></ul><a class="button button-primary" href={publicationPath(guide)}>Otwórz przewodnik <span aria-hidden="true">↗</span></a><p class="publication-meta">{guide.data.author} · Aktualizacja: <time datetime={guide.data.updatedAt}>{publicationDateLabel(guide.data.updatedAt)}</time></p></div>
    <div class="knowledge-cover" aria-hidden="true"><div class="knowledge-cover-orbit"></div><span class="knowledge-cover-label">INFORMATYKA<br />ROZSZERZONA</span><strong>{guide.data.examYear}</strong><span class="knowledge-cover-bottom">WIEDZA → PRAKTYKA</span><span class="knowledge-cover-code">if ready:<br />&nbsp;&nbsp;take_next_step()</span></div>
  </article>}
  {articles.length > 0 && <section class="knowledge-articles" aria-labelledby="knowledge-articles-title"><div class="knowledge-section-title"><p class="eyebrow">UCZ SIĘ ZE ZROZUMIENIEM</p><h2 id="knowledge-articles-title">Artykuły i omówienia</h2></div><div class="knowledge-article-grid">{articles.map(entry => <article class="knowledge-article"><p class="publication-kicker">{publicationSections[entry.data.section]}</p><h3><a href={publicationPath(entry)}>{entry.data.title}</a></h3><p>{entry.data.description}</p><p class="publication-meta"><time datetime={entry.data.updatedAt}>{publicationDateLabel(entry.data.updatedAt)}</time></p><a class="text-link" href={publicationPath(entry)}>Czytaj artykuł <span aria-hidden="true">→</span></a></article>)}</div></section>}
  <section class="knowledge-practice" aria-labelledby="knowledge-practice-title"><div><p class="eyebrow">WIEDZA NABIERA SENSU W PRAKTYCE</p><h2 id="knowledge-practice-title">Sprawdź ją w zadaniu.</h2><p>Wybierz jeden temat albo zmierz się z całym arkuszem. Porównaj odpowiedź, znajdź przyczynę błędu i spróbuj ponownie.</p></div><div><a class="text-link" href="/zadania/">Zadania według tematów →</a><a class="text-link" href="/arkusze/">Arkusze i odpowiedzi CKE →</a></div></section>
</PublicationLayout>
